{
  "name": "@koshirme/student-desktop",
  "version": "0.1.7",
  "description": "KOSH!RME student exam guard",
  "author": "KOSH!RME",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "predev": "install-electron",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "npm run typecheck && node scripts/build-native-macos.mjs && electron-vite build",
    "typecheck": "tsc --noEmit",
    "prepreview": "install-electron",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "dist:mac": "node scripts/build-macos.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@koshirme/protocol": "*",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-vite": "^5.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.1",
    "@types/ws": "^8.18.1"
  }
}
