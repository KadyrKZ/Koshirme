{
  "manifest_version": 3,
  "name": "KOSH!RME · Көшірме (Koshirme / Коширме)",
  "short_name": "Көшірме",
  "description": "Көшірме / KOSH!RME — бақылау жүйесі: контест кезінде рұқсат етілген беттер, мұғаліммен байланыс және бұзушылық туралы хабарлау.",
  "version": "0.3.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://koshirme.stream/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Көшірме · KOSH!RME"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http: https: ws: wss:"
  }
}
