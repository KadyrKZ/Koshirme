# Local development defaults only. Change ADMIN_TOKEN before use on a LAN.
POSTGRES_DB=examguard
POSTGRES_USER=examguard
POSTGRES_PASSWORD=examguard_local
DATABASE_URL=postgresql+asyncpg://examguard:examguard_local@localhost:5432/examguard
ADMIN_TOKEN=examguard-local-teacher-key
# Development tests only. Keep false in deployed environments.
ALLOW_LEGACY_ADMIN=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
UPLOAD_DIR=uploads/screenshots
SEED_DEMO=true
HEARTBEAT_TIMEOUT_SECONDS=15
MONITORING_LEASE_SECONDS=12
MAX_SCREENSHOT_BYTES=5242880
# For Vite: copy these into apps/admin-web/.env if overriding defaults.
VITE_API_URL=http://localhost:8000
# Desktop development overrides. Production students never see or edit these values.
KOSHIRME_BACKEND_URL=http://localhost:8000
KOSHIRME_LOCAL_PORT=17891
