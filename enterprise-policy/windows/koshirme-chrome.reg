Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"GenAiDefaultSettings"=dword:00000002
"GeminiSettings"=dword:00000001
"AIModeSettings"=dword:00000001
"SearchContentSharingSettings"=dword:00000001
"GoogleSearchSidePanelEnabled"=dword:00000000
"LensOverlaySettings"=dword:00000001
"LensRegionSearchEnabled"=dword:00000000
"LensDesktopNTPSearchEnabled"=dword:00000000
"IncognitoModeAvailability"=dword:00000001
"BrowserGuestModeEnabled"=dword:00000000
"BrowserAddPersonEnabled"=dword:00000000
"DeveloperToolsAvailability"=dword:00000002
"TaskManagerEndProcessEnabled"=dword:00000000
"PrintingEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\URLBlocklist]
"1"="chrome://extensions"
"2"="chrome://extensions-internals"
"3"="chrome://flags"
"4"="chrome://inspect"
"5"="chrome://settings"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallBlocklist]
"1"="*"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="mcfibeppldfkaahnjdpbcfpbncemolnp;https://clients2.google.com/service/update2/crx"
